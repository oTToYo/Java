# 複製為 .env 後填入真實值（.env 請勿提交）

# FinMind（可選，historical_source=finmind 時需要）
FINMIND_TOKEN=

# LINE Messaging API（Notify 已停用）
# 到 https://developers.line.biz/ 建立 Messaging API Channel
LINE_CHANNEL_ACCESS_TOKEN=
# 使用者或群組 ID（可透過 webhook 取得）
LINE_USER_ID=

# 永豐 Shioaji
# 申請：永豐金證券 API 管理頁
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_PERSON_ID=
SHIOAJI_CA_PASSWD=
SHIOAJI_CA_PATH=certs/Sinopac.pfx
# true=模擬（預設），false=實盤（仍需 ENABLE_LIVE_TRADING=true）
SHIOAJI_SIMULATION=true
ENABLE_LIVE_TRADING=false

STOCK_DB_PATH=data/stocks.db
